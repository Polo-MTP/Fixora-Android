<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo en la nube y paso a otro celular (Android 12+). La sesión se excluye por la misma
     razón que en backup_rules.xml: al cambiar de dispositivo hay que iniciar sesión otra vez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
