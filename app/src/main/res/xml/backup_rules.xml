<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo automático en Android 11 o anterior. La sesión no se respalda: sus tokens están
     cifrados con una llave del Keystore que no sale del dispositivo, así que en otro celular
     no servirían. -->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
